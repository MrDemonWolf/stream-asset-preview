# Optional: enables the Showcase "Load from channel" feature.
# Register a Twitch application (https://dev.twitch.tv/console/apps), add
# <origin>/stream-asset-preview/ (and http://localhost:5173/stream-asset-preview/
# for dev) as OAuth Redirect URLs, and paste the public Client ID below.
# This is a PUBLIC identifier used with the OAuth Implicit flow — never a secret.
# When unset, the feature is hidden and the app still builds/runs.
VITE_TWITCH_CLIENT_ID=
